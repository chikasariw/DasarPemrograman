source("D:/KULIAH/Dasar Pemrograman/R/01-12-2025/Tugas_Kelompok3/No_4_Kelompok3_Alfa Laela Ali_250314621327_Chika Sari Wibowo_250314619191_Qaila Aulia Artanti_250314618930.r")
n <- as.numeric(readline("Masukkan nilai n: "))
jumlah <- 0
for (i in 1:n) {
jumlah <- jumlah + 1/(i^2)
}
phi <- sqrt(6 * jumlah)
cat(sprintf("Nilai phi = %.14f\n", phi))
